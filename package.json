    "viewsWelcome": [
      {
        "view": "gitsight.search",
        "contents": "Search commits by message, author, SHA, file or code changes.\n[Search Commits](command:gitsight.searchCommits)\nCompare two branches, tags or commits.\n[Compare References](command:gitsight.compareRefs)"
      },
      {
        "view": "gitsight.fileHistory",
        "contents": "Open a file tracked by Git to see its history."
      },
      {
        "view": "gitsight.lineHistory",
        "contents": "Select lines in a file tracked by Git to see their history."
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gitsight.showCommitGraph",
          "when": "view == gitsight.commits",
          "group": "navigation@1"
        },
        {
          "command": "gitsight.searchCommits",
          "when": "view == gitsight.commits",
          "group": "navigation@2"
        },
        {
          "command": "gitsight.fetch",
          "when": "view == gitsight.commits || view == gitsight.remotes",
          "group": "navigation@3"
        },
        {
          "command": "gitsight.refreshViews",
          "when": "view =~ /^gitsight\\./",
          "group": "navigation@9"
        },
        {
          "command": "gitsight.createBranch",
          "when": "view == gitsight.branches",
          "group": "navigation@1"
        },
        {
          "command": "gitsight.createTag",
          "when": "view == gitsight.tags",
          "group": "navigation@1"
        },
        {
          "command": "gitsight.stashSave",
          "when": "view == gitsight.stashes",
          "group": "navigation@1"
        },
        {
          "command": "gitsight.worktreeCreate",
          "when": "view == gitsight.worktrees",
          "group": "navigation@1"
        },
        {
          "command": "gitsight.searchCommits",
          "when": "view == gitsight.search",
          "group": "navigation@1"
        },
        {
          "command": "gitsight.compareRefs",
          "when": "view == gitsight.search",
          "group": "navigation@2"
        },
        {
          "command": "gitsight.clearSearch",
          "when": "view == gitsight.search",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "gitsight.openCommitOnRemote",
          "when": "viewItem =~ /^gitsight:commit/",
          "group": "inline@1"
        },
        {
          "command": "gitsight.showCommitDetails",
          "when": "viewItem =~ /^gitsight:commit/",
          "group": "1_view@1"
        },
        {
          "command": "gitsight.copySha",
          "when": "viewItem =~ /^gitsight:commit/",
          "group": "2_copy@1"
        },
        {
          "command": "gitsight.copyMessage",
          "when": "viewItem =~ /^gitsight:commit/",
          "group": "2_copy@2"
        },
        {
          "command": "gitsight.openCommitOnRemote",
          "when": "viewItem =~ /^gitsight:commit/",
          "group": "2_copy@3"
        },
        {
          "command": "gitsight.checkout",
          "when": "viewItem =~ /^gitsight:commit/",
          "group": "3_actions@1"
        },
        {
          "command": "gitsight.createBranch",
          "when": "viewItem =~ /^gitsight:commit/",
          "group": "3_actions@2"
        },
        {
          "command": "gitsight.createTag",
          "when": "viewItem =~ /^gitsight:commit/",
          "group": "3_actions@3"
        },
        {
          "command": "gitsight.cherryPick",
          "when": "viewItem =~ /^gitsight:commit/",
          "group": "3_actions@4"
        },
        {
          "command": "gitsight.revertCommit",
          "when": "viewItem =~ /^gitsight:commit/",
          "group": "3_actions@5"
        },
        {
          "command": "gitsight.resetToCommit",
          "when": "viewItem =~ /^gitsight:commit/",
          "group": "3_actions@6"
        },
        {
          "command": "gitsight.checkout",
          "when": "viewItem == gitsight:branch || viewItem == gitsight:remoteBranch || viewItem == gitsight:tag",
          "group": "inline@1"
        },
        {
          "command": "gitsight.checkout",
          "when": "viewItem == gitsight:branch || viewItem == gitsight:remoteBranch || viewItem == gitsight:tag",
          "group": "1_actions@1"
        },
        {
          "command": "gitsight.mergeBranch",
          "when": "viewItem == gitsight:branch || viewItem == gitsight:remoteBranch || viewItem == gitsight:tag",
          "group": "1_actions@2"
        },
        {
          "command": "gitsight.rebaseOnto",
          "when": "viewItem == gitsight:branch || viewItem == gitsight:remoteBranch",
          "group": "1_actions@3"
        },
        {
          "command": "gitsight.createBranch",
          "when": "viewItem == gitsight:branch || viewItem == gitsight:remoteBranch || viewItem == gitsight:tag",
          "group": "1_actions@4"
        },
        {
          "command": "gitsight.compareRefs",
          "when": "viewItem == gitsight:branch || viewItem == gitsight:currentBranch || viewItem == gitsight:remoteBranch || viewItem == gitsight:tag",
          "group": "2_compare@1"
        },
        {
          "command": "gitsight.deleteBranch",
          "when": "viewItem == gitsight:branch",
          "group": "9_delete@1"
        },
        {
          "command": "gitsight.deleteTag",
          "when": "viewItem == gitsight:tag",
          "group": "9_delete@1"
        },
        {
          "command": "gitsight.stashApply",
          "when": "viewItem == gitsight:stash",
          "group": "inline@1"
        },
        {
          "command": "gitsight.stashApply",
          "when": "viewItem == gitsight:stash",
          "group": "1_actions@1"
        },
        {
          "command": "gitsight.stashPop",
          "when": "viewItem == gitsight:stash",
          "group": "1_actions@2"
        },
        {
          "command": "gitsight.stashDrop",
          "when": "viewItem == gitsight:stash",
          "group": "9_delete@1"
        },
        {
          "command": "gitsight.worktreeOpen",
          "when": "viewItem =~ /^gitsight:worktree/",
          "group": "inline@1"
        },
        {
          "command": "gitsight.worktreeRemove",
          "when": "viewItem == gitsight:worktree",
          "group": "9_delete@1"
        }
      ],
