    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitsight",
          "title": "GitSight",
          "icon": "resources/gitsight.svg"
        }
      ]
    },
    "views": {
      "gitsight": [
        {
          "id": "gitsight.commits",
          "name": "Commits"
        },
        {
          "id": "gitsight.fileHistory",
          "name": "File History"
        },
        {
          "id": "gitsight.lineHistory",
          "name": "Line History",
          "visibility": "collapsed"
        },
        {
          "id": "gitsight.branches",
          "name": "Branches"
        },
        {
          "id": "gitsight.remotes",
          "name": "Remotes",
          "visibility": "collapsed"
        },
        {
          "id": "gitsight.tags",
          "name": "Tags",
          "visibility": "collapsed"
