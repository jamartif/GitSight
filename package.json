      },
      {
        "command": "gitsight.openRepoOnRemote",
        "title": "Open Repository on Remote",
        "category": "GitSight"
      },
      {
        "command": "gitsight.copySha",
        "title": "Copy Commit SHA",
        "category": "GitSight"
      },
      {
        "command": "gitsight.copyMessage",
