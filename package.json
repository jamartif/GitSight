        {
          "command": "gitsight.deleteTag",
          "when": "false"
        },
        {
          "command": "gitsight.stashApply",
          "when": "false"
        },
        {
          "command": "gitsight.stashPop",
          "when": "false"
        },
        {
          "command": "gitsight.stashDrop",
          "when": "false"
        },
        {
          "command": "gitsight.mergeBranch",
          "when": "false"
        },
        {
          "command": "gitsight.rebaseOnto",
          "when": "false"
        },
        {
          "command": "gitsight.cherryPick",
          "when": "false"
        },
        {
          "command": "gitsight.revertCommit",
          "when": "false"
        },
        {
          "command": "gitsight.resetToCommit",
          "when": "false"
        },
        {
          "command": "gitsight.worktreeOpen",
          "when": "false"
        },
        {
          "command": "gitsight.worktreeRemove",
          "when": "false"
        },
        {
          "command": "gitsight.openChangedFile",
          "when": "false"
        },
        {
          "command": "gitsight.copySha",
          "when": "false"
        },
        {
          "command": "gitsight.copyMessage",
          "when": "false"
        },
        {
          "command": "gitsight.openCommitOnRemote",
          "when": "false"
        },
        {
          "command": "gitsight.clearSearch",
          "when": "false"
        }
      ]
    },
    "submenus": [
      {
        "id": "gitsight.editorContext",
        "label": "GitSight"
      }
    ],
    "keybindings": [
      {
        "command": "gitsight.toggleFileBlame",
        "key": "alt+b",
        "when": "editorTextFocus"
      },
      {
        "command": "gitsight.toggleFileHeatmap",
        "key": "alt+h",
        "when": "editorTextFocus"
      },
      {
        "command": "gitsight.showLineCommit",
        "key": "alt+c",
        "when": "editorTextFocus"
      },
      {
        "command": "gitsight.diffWithPrevious",
        "key": "alt+,",
        "when": "editorTextFocus"
      },
      {
        "command": "gitsight.showCommitGraph",
        "key": "ctrl+alt+g",
        "mac": "cmd+alt+g"
      }
    ]
  },
