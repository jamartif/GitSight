{
  "name": "gitsight",
  "displayName": "GitSight — Free Git Supercharged",
  "description": "100% free and open-source Git superpowers for VS Code: inline blame, hovers, CodeLens, heatmaps, file & line history, commit graph, branches, tags, stashes, worktrees, contributors, commit search, remote links and more. No accounts, no paywalls, no telemetry.",
  "version": "0.2.0",
  "publisher": "jamartif",
  "license": "MIT",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/jamartif/GitSight"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "git",
    "blame",
    "history",
    "graph",
    "annotations",
    "free",
    "open source"
  ],
  "activationEvents": [
    "workspaceContains:.git",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "GitSight",
      "properties": {
        "gitsight.currentLine.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show blame information at the end of the current line."
        },
        "gitsight.currentLine.format": {
          "type": "string",
          "default": "${author}, ${agoOrDate} • ${message}",
          "markdownDescription": "Format of the current line blame. Tokens: `${author}`, `${email}`, `${date}`, `${ago}`, `${agoOrDate}`, `${message}`, `${sha}`, `${shortSha}`."
        },
        "gitsight.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show blame information for the current line in the status bar."
        },
        "gitsight.statusBar.format": {
          "type": "string",
          "default": "$(git-commit) ${author}, ${ago}",
          "description": "Format of the status bar blame (same tokens as the current line format, codicons allowed)."
        },
        "gitsight.hovers.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show rich commit details when hovering over lines."
        },
        "gitsight.hovers.currentLineOnly": {
          "type": "boolean",
          "default": true,
          "description": "Only show blame hovers on the current line."
        },
        "gitsight.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show recent change and authors CodeLens above files and symbols."
        },
        "gitsight.codeLens.scope": {
          "type": "string",
          "enum": [
            "document",
            "symbols"
          ],
          "default": "symbols",
          "description": "Show CodeLens only at the top of the file, or also above each class/function/method."
        },
        "gitsight.dateFormat": {
          "type": "string",
          "default": "",
          "description": "Absolute date format (empty = locale). Tokens: YYYY, MM, DD, HH, mm."
        },
        "gitsight.dateStyle": {
          "type": "string",
          "enum": [
            "relative",
            "absolute"
          ],
          "default": "relative",
          "description": "Style used by the ${agoOrDate} token."
        },
        "gitsight.heatmap.hotColor": {
          "type": "string",
          "default": "#f66a0a",
          "description": "Heatmap color for recent changes."
        },
        "gitsight.heatmap.coldColor": {
          "type": "string",
          "default": "#0a60f6",
          "description": "Heatmap color for old changes."
        },
        "gitsight.heatmap.ageThresholdDays": {
          "type": "number",
          "default": 90,
          "description": "Changes newer than this number of days are considered 'hot'."
        },
        "gitsight.views.maxCommits": {
          "type": "number",
          "default": 200,
          "description": "Maximum number of commits loaded in the history views and the commit graph."
        },
        "gitsight.baseBranches": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "main",
            "master",
            "trunk",
            "develop",
            "development",
            "dev"
          ],
          "description": "Long-lived branches (in priority order) used to work out which branch a commit was made on and which branch it branched from."
        },
        "gitsight.remotes.custom": {
          "type": "array",
          "default": [],
          "markdownDescription": "Custom remote providers for self-hosted servers. Example: `[{ \"domain\": \"git.mycompany.com\", \"type\": \"gitlab\" }]`. Types: `github`, `gitlab`, `bitbucket`, `azure`, `gitea`.",
          "items": {
            "type": "object",
            "properties": {
              "domain": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "github",
                  "gitlab",
                  "bitbucket",
                  "azure",
                  "gitea"
                ]
              }
            }
          }
        }
      }
    },
    "commands": [
      {
        "command": "gitsight.toggleFileBlame",
        "title": "Toggle File Blame",
        "category": "GitSight",
        "icon": "$(person)"
      },
      {
